{
  "name": "smart-web-extension",
  "version": "0.1.0",
  "description": "Smart Web: reads an unfamiliar page, asks Meta models for a layout plan, and applies it locally",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">22.7.0"
  },
  "type": "module",
  "scripts": {
    "start": "dotenv -e .env.local node scripts/esbuild.config.ts",
    "build": "NODE_ENV=production node scripts/esbuild.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache --no-error-on-unmatched-pattern {src,scripts}",
    "format": "prettier --no-editorconfig src/**/*.* --check",
    "format:fix": "prettier --no-editorconfig src/**/*.* --write",
    "test:e2e": "E2E=1 npm run build && playwright test"
  },
  "dependencies": {
    "@gravity-ui/icons": "^2.18.0",
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@craftamap/esbuild-plugin-html": "0.9.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/chrome": "^0.1.12",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "dotenv-cli": "7.2.1",
    "esbuild": "^0.25.0",
    "esbuild-plugin-clean": "1.0.1",
    "esbuild-plugin-copy": "2.1.1",
    "esbuild-style-plugin": "1.6.3",
    "eslint": "9.35.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-unicorn": "61.0.2",
    "postcss": "^8.5.6",
    "prettier": "2.8.3",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.2"
  }
}
