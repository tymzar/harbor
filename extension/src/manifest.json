{
  "manifest_version": 3,
  "version": "0.1.0",
  "name": "Harbor",
  "description": "A calm place on a busy web: Harbor reshapes any page around what you use, and changes nothing until you keep it.",
  "minimum_chrome_version": "121",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "background": {
    "service_worker": "background/index.js"
  },
  "action": {
    "default_title": "Harbor: read this page",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "host_permissions": [
    "http://127.0.0.1:4000/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
