{
  "manifest_version": 3,
  "version": "0.1.0",
  "name": "Smart Web",
  "description": "Reads an unfamiliar page, proposes a layout plan, and applies it locally.",
  "minimum_chrome_version": "121",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "background": {
    "service_worker": "background/index.js"
  },
  "action": {
    "default_title": "Smart Web: read this page",
    "default_icon": "32x32.png"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "icons": {
    "32": "32x32.png",
    "128": "128x128.png"
  },
  "host_permissions": [
    "http://127.0.0.1:4000/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
